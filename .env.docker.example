# Application
APP_NAME="CallShift HR"
APP_ENV=local
APP_KEY=base64:q6s1A3oGZt4j8fX9bV2k5L7m8N0p1Q2r3S4t5U6v7W8=
APP_DEBUG=false
APP_URL=http://localhost:8000
